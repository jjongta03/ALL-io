# npm run setup creates .env.local with a fresh local configuration.
APP_ENV=local
APP_MODE=demo
APP_URL=http://127.0.0.1:3000
# Leave empty to use local PGlite. Production requires PostgreSQL.
MAWD_DATABASE_URL=
LOCAL_DATABASE_PATH=./data/postgres
EMAIL_TRANSPORT=local
STIBEE_API_KEY=
STIBEE_AUTO_EMAIL_URL=
LINER_API_KEY=
NTS_API_KEY=
SOURCE_COLLECTION_ENABLED=false
LIVE_INTEGRATIONS_ENABLED=false
DRAFT_GENERATION_ENABLED=false
# Choose a model supported by your Liner account before enabling drafting.
LINER_DRAFT_MODEL=
JEV_ENABLED=false
LINER_DECISION_MODEL=typesafe/jev-1.14
NEXT_TELEMETRY_DISABLED=1

# v2 contracts: no external processing by default. PDF needs a PDF-capable catalog model.
CONTRACT_SCAN_ENABLED=false
LINER_CONTRACT_MODEL=
LINER_CONTRACT_PDF_MODEL=
# 64 hex characters; mandatory for storing contracts in production. Never commit the real key.
CONTRACT_ENCRYPTION_KEY=

# Connected workflows: off by default; no external calls in ordinary local checks.
STIBEE_CONTACT_SYNC_ENABLED=false
STIBEE_LIST_ID=
POLICY_WATCH_ENABLED=false
