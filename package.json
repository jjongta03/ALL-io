{
  "name": "mawd-business-change",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "start:host": "next start --hostname 0.0.0.0",
    "deploy:init": "tsx scripts/deploy-init.ts",
    "deploy:start": "npm run deploy:init && npm run start:host",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "user:create": "tsx scripts/create-user.ts",
    "jobs:run": "tsx scripts/jobs.ts",
    "jobs:workspace": "tsx scripts/workspace-jobs.ts",
    "jobs:connected": "tsx scripts/connected-jobs.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:workspace": "tsx scripts/smoke-workspace.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "format": "prettier --write --ignore-unknown src scripts tests docs db .github *.json *.ts *.yaml README.md AGENTS.md",
    "format:check": "prettier --check --ignore-unknown src scripts tests docs db .github *.json *.ts *.yaml README.md AGENTS.md"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "dotenv": "18.0.10",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
